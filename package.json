{
  "name": "claude-usage-vscode",
  "displayName": "Claude Usage for VS Code",
  "description": "Shows your Claude Code usage (5-hour session and 7-day window) in the status bar, and the monthly spend on accounts billed by money.",
  "version": "1.3.0",
  "publisher": "alexlora87",
  "icon": "resources/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "svg2ttf": "^6.1.0",
    "ttf2woff": "^3.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeUsage.refresh",
        "title": "Claude Usage: Refresh"
      },
      {
        "command": "claudeUsage.showHistory",
        "title": "Claude Usage: Show History"
      },
      {
        "command": "claudeUsage.showMenu",
        "title": "Claude Usage: Show Menu"
      },
      {
        "command": "claudeUsage.toggleExtendedView",
        "title": "Claude Usage: Toggle Extended View"
      },
      {
        "command": "claudeUsage.openSettings",
        "title": "Claude Usage: Open Settings"
      }
    ],
    "keybindings": [
      {
        "command": "claudeUsage.refresh",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u"
      }
    ],
    "configuration": {
      "title": "Claude Usage",
      "properties": {
        "claudeUsage.refreshInterval": {
          "order": 1,
          "type": "number",
          "default": 120,
          "minimum": 30,
          "maximum": 3600,
          "description": "Seconds between usage requests."
        },
        "claudeUsage.windows": {
          "order": 2,
          "type": "string",
          "enum": [
            "both",
            "session",
            "weekly"
          ],
          "enumDescriptions": [
            "Show the 5-hour session and the 7-day window.",
            "Show only the 5-hour session.",
            "Show only the 7-day window."
          ],
          "default": "both",
          "description": "Which usage windows the status bar, the notifications and the history show."
        },
        "claudeUsage.extendedView": {
          "order": 3,
          "type": "boolean",
          "default": false,
          "description": "Show full labels (Session (5hr), Weekly (7 day), Resets in) in the status bar."
        },
        "claudeUsage.indicator": {
          "order": 4,
          "type": "string",
          "enum": [
            "ring",
            "bar"
          ],
          "enumDescriptions": [
            "A ring that fills up next to each percentage.",
            "A progress bar next to each percentage."
          ],
          "default": "ring",
          "description": "How the status bar draws the usage next to the percentage."
        },
        "claudeUsage.barSize": {
          "order": 5,
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "enumDescriptions": [
            "A short bar.",
            "A longer bar.",
            "The longest bar."
          ],
          "default": "small",
          "description": "Length of the progress bar. Only used when the indicator is bar."
        },
        "claudeUsage.showSpend": {
          "order": 6,
          "type": "string",
          "enum": [
            "auto",
            "never"
          ],
          "enumDescriptions": [
            "Show the monthly spend when the account has extra usage enabled with a limit.",
            "Never show the monthly spend."
          ],
          "default": "auto",
          "description": "Monthly spend, for accounts billed by money instead of by usage window."
        },
        "claudeUsage.notifications": {
          "order": 7,
          "type": "boolean",
          "default": true,
          "description": "Show a notification once per window cycle when usage reaches the warning or the critical threshold."
        },
        "claudeUsage.warningThreshold": {
          "order": 8,
          "type": "number",
          "default": 70,
          "minimum": 1,
          "maximum": 99,
          "description": "Percentage from which the status bar turns yellow. Must be lower than the critical threshold."
        },
        "claudeUsage.criticalThreshold": {
          "order": 9,
          "type": "number",
          "default": 90,
          "minimum": 2,
          "maximum": 100,
          "description": "Percentage from which the status bar turns red."
        }
      }
    },
    "icons": {
      "claude-usage-ring-00": {
